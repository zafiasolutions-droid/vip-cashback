
{% if product %}
  <div id="vip-product-lock-{{ product.id }}">
    <div
      id="vip-lock-message-{{ product.id }}"
      style="display: none;"
    >
      <h3>VIP Early Access</h3>

      <p>
        This product is currently available exclusively to VIP customers.
      </p>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", async function () {
      const productId = "{{ product.id }}";

      const lockContainer =
        document.getElementById(
          "vip-product-lock-{{ product.id }}"
        );

      const lockMessage =
        document.getElementById(
          "vip-lock-message-{{ product.id }}"
        );

      try {
        const response = await fetch(
          `/apps/vip-access?product_id=${productId}`
        );

        const result = await response.json();

        console.log(
          "VIP Access Result:",
          result
        );

        if (!result.allowed) {
          lockMessage.style.display = "block";

          // Hide product purchase buttons.
          const addToCartButtons =
            document.querySelectorAll(
              'button[type="submit"][name="add"]'
            );

          addToCartButtons.forEach((button) => {
            button.style.display = "none";
          });
        }
      } catch (error) {
        console.error(
          "VIP Access check failed:",
          error
        );
      }
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "VIP Product Lock",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Restricts VIP Early Access products to eligible customers."
    }
  ]
}
{% endschema %}